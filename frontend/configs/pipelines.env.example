# Pipelines server environment variables — copy to pipelines.env and fill in secrets.
# NEVER commit pipelines.env to version control.
# ARCHMIND_API_KEY must NEVER appear in logs, URLs, or browser-side code.

# ── ArchMind backend connection ───────────────────────────────────────────────
# URL of the ArchMind FastAPI backend reachable from the Pipelines container.
# For local dev: http://host.docker.internal:8000
# For Docker Compose with backend on same network: http://backend:8000
ARCHMIND_API_URL=http://host.docker.internal:8000

# Secret key for ArchMind API authentication (X-API-Key header).
# Generate a key ≥32 chars. Treat as a production secret.
ARCHMIND_API_KEY=

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Seconds between job status polls (default: 5)
POLL_INTERVAL_SECONDS=5

# Maximum seconds to wait for a job before timing out (default: 1800)
MAX_POLL_DURATION_SECONDS=1800
