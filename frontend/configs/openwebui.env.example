# OpenWebUI environment variables — copy to openwebui.env and fill in secrets.
# NEVER commit openwebui.env to version control.
# Reference: https://docs.openwebui.com/getting-started/env-configuration/

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

# ── Branding ──────────────────────────────────────────────────────────────────
WEBUI_NAME=ArchMind AI

# ── Auth ──────────────────────────────────────────────────────────────────────
# false = admin must create all accounts (approved F1 decision I3)
ENABLE_SIGNUP=false

# ── Default model ─────────────────────────────────────────────────────────────
# Set to the ArchMind pipeline model ID after F1 registration is verified.
# ⚠ VERIFY AT F1: exact model ID format depends on Pipelines version (see PIPELINE_API_CONTRACT.md Section 13)
DEFAULT_MODELS=archmind_ai

# ── Pipelines server ──────────────────────────────────────────────────────────
# Internal Docker network address of the Pipelines server
OPENAI_API_BASE_URL=http://pipelines:9099
# Static key accepted by the Pipelines server (not the ArchMind API key)
OPENAI_API_KEY=0p3n-w3bu!

# ── Disable unused AI providers ───────────────────────────────────────────────
ENABLE_OLLAMA_API=false
